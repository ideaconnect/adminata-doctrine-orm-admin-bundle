{% extends '@Adminata/Form/form_admin_fields.html.twig' %}


{# Custom Sonata Admin Extension #}
{% block adminata_admin_orm_one_to_one_widget %}
    {% include '@Adminata/CRUD/Association/edit_one_to_one.html.twig' %}
{% endblock %}

{% block adminata_admin_orm_many_to_many_widget %}
    {% include '@Adminata/CRUD/Association/edit_many_to_many.html.twig' %}
{% endblock %}

{% block adminata_admin_orm_many_to_one_widget %}
    {% include '@Adminata/CRUD/Association/edit_many_to_one.html.twig' %}
{% endblock %}

{% block adminata_admin_orm_one_to_many_widget %}
    {% include '@Adminata/CRUD/Association/edit_one_to_many.html.twig' %}
{% endblock %}

{% block adminata_type_model_widget %}
    {#
        This is not the best way to do if
        TODO : improve this part
    #}

    {#model {{ adminata_admin.field_description.mappingtype }}#}

    {% if adminata_admin.field_description is empty %}
        {{ block('choice_widget') }}
    {% elseif adminata_admin.field_description.mappingtype == constant('Doctrine\\ORM\\Mapping\\ClassMetadata::ONE_TO_ONE') %}
        {{ block('adminata_admin_orm_one_to_one_widget') }}
    {% elseif adminata_admin.field_description.mappingtype == constant('Doctrine\\ORM\\Mapping\\ClassMetadata::MANY_TO_ONE') %}
        {{ block('adminata_admin_orm_many_to_one_widget') }}
    {% elseif adminata_admin.field_description.mappingtype == constant('Doctrine\\ORM\\Mapping\\ClassMetadata::MANY_TO_MANY') %}
        {{ block('adminata_admin_orm_many_to_many_widget') }}
    {% elseif adminata_admin.field_description.mappingtype == constant('Doctrine\\ORM\\Mapping\\ClassMetadata::ONE_TO_MANY') %}
        {{ block('adminata_admin_orm_one_to_many_widget') }}
    {% else %}
        {#INVALID MODE : {{ id }}#}
        {{ block('choice_widget') }}
    {% endif %}
{% endblock %}

{% block adminata_type_admin_widget %}
    {#admin {{ adminata_admin.field_description.mappingtype }}#}
    {% if adminata_admin.field_description.mappingtype == constant('Doctrine\\ORM\\Mapping\\ClassMetadata::ONE_TO_ONE') %}
        {{ block('adminata_admin_orm_one_to_one_widget') }}
    {% elseif adminata_admin.field_description.mappingtype == constant('Doctrine\\ORM\\Mapping\\ClassMetadata::MANY_TO_ONE') %}
        {{ block('adminata_admin_orm_many_to_one_widget') }}
    {% elseif adminata_admin.field_description.mappingtype == constant('Doctrine\\ORM\\Mapping\\ClassMetadata::MANY_TO_MANY') %}
        {{ block('adminata_admin_orm_many_to_many_widget') }}
    {% elseif adminata_admin.field_description.mappingtype == constant('Doctrine\\ORM\\Mapping\\ClassMetadata::ONE_TO_MANY') %}
        {{ block('adminata_admin_orm_one_to_many_widget') }}
    {% else %}
        INVALID MODE : {{ id }}
    {% endif %}
{% endblock %}

{% block adminata_type_collection_widget %}
    {% if adminata_admin.field_description.mappingtype == constant('Doctrine\\ORM\\Mapping\\ClassMetadata::ONE_TO_MANY') %}
        {{ block('adminata_admin_orm_one_to_many_widget') }}
    {% elseif adminata_admin.field_description.mappingtype == constant('Doctrine\\ORM\\Mapping\\ClassMetadata::MANY_TO_MANY') %}
        {{ block('adminata_admin_orm_many_to_many_widget') }}
    {% else %}
        INVALID MODE : {{ id }} - type : CollectionType - mapping : {{ adminata_admin.field_description.mappingtype }}
    {% endif %}
{% endblock %}

